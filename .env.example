# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatbot_db
DB_USER=chatbot_user
DB_PASSWORD=your_secure_password_here

# Application Configuration
APP_ENV=development
APP_HOST=localhost
APP_PORT=5000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Model Configuration
MODEL_PATH=data/processed/chatbot_model.pth
CONFIDENCE_THRESHOLD=0.75

# Training Configuration
HIDDEN_SIZE=8
NUM_EPOCHS=1000
BATCH_SIZE=8
LEARNING_RATE=0.001